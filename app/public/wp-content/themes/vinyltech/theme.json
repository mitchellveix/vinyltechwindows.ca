{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,

  "settings": {

    "appearanceTools": true,

    "color": {
      "palette": [
        {
          "slug": "primary",
          "name": "Primary",
          "color": "#7f2320"
        },
        {
          "slug": "secondary",
          "name": "Secondary",
          "color": "#a78033"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#3779a4"
        },
        {
          "slug": "light",
          "name": "Light",
          "color": "#ffefcd"
        },
        {
          "slug": "white",
          "name": "White",
          "color": "#FFFFFF"
        }
      ]
    },

    "border": {
			"radius": false
		},

    "typography": {
        "fontFamilies": [
            {
                "slug": "heading",
                "name": "Heading Font",
                "fontFamily": "Montserrat, sans-serif"
            },
            {
                "slug": "body",
                "name": "Body Font",
                "fontFamily": "Open Sans, sans-serif"
            }
        ]
    },

    "spacing": {
        "spacingSizes": [
            {
                "slug": "small",
                "name": "Small",
                "size": "16px"
            },
            {
                "slug": "medium",
                "name": "Medium",
                "size": "32px"
            },
            {
                "slug": "large",
                "name": "Large",
                "size": "64px"
            }
        ]
    }
  },

  "layout": {
      "contentSize": "800px",
      "wideSize": "1200px"
  },

  "styles": {
    "typography": {
      "fontFamily": "var:preset|font-family|body"
    },

    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading"
        }
      }
    }
  }
}